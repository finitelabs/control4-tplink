<devicedata>
  <name>TP-Link Light</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>TP-Link Light</model>
  <creator>Derek Miller</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>07/10/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Lighting</category>
  </composer_categories>
  <conditionals/>
  <events/>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <!-- #endif -->
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #ifndef DRIVERCENTRAL -->
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>DYNAMIC_LIST</type>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
      <property>
        <name>TP-Link Settings</name>
        <type>LABEL</type>
        <default>TP-Link Settings</default>
      </property>
      <property>
        <name>IP Address</name>
        <type>STRING</type>
        <default/>
        <description>IP address of the light, or blank when bound to a TP-Link Outlet.</description>
      </property>
      <property>
        <name>MAC Address</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
        <description>MAC address of the light, learned when it first connects.</description>
      </property>
      <property>
        <name>Protocol</name>
        <type>LIST</type>
        <items>
          <item>Auto</item>
          <item>KLAP</item>
          <item>TPAP</item>
          <item>Legacy</item>
        </items>
        <default>Auto</default>
        <description>Local protocol the light speaks, detected when set to Auto.</description>
      </property>
      <property>
        <name>TP-Link Username</name>
        <type>STRING</type>
        <default/>
        <description>Case-sensitive email of the TP-Link (Kasa/Tapo) account the light is bound to.</description>
      </property>
      <property>
        <name>TP-Link Password</name>
        <type>STRING</type>
        <password>true</password>
        <default/>
        <description>Password of the TP-Link (Kasa/Tapo) account the light is bound to.</description>
      </property>
      <property>
        <name>Poll Rate (Seconds)</name>
        <type>RANGED_INTEGER</type>
        <minimum>2</minimum>
        <maximum>300</maximum>
        <default>5</default>
        <description>How often to poll the light state in direct mode.</description>
      </property>
      <property>
        <name>Fades</name>
        <type>LIST</type>
        <items>
          <item>Driver</item>
          <item>Light</item>
        </items>
        <default>Driver</default>
        <description>Who makes a fade on a Tapo light: the driver or the light itself.</description>
      </property>
    </properties>
    <commands/>
    <actions>
      <action>
        <name>Reconnect</name>
        <command>Reconnect</command>
      </action>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>UpdateDrivers</command>
      </action>
      <!-- #endif -->
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
  </config>
  <!-- The light's capabilities are the build's, written from the profile the driver gives Light.new. -->
  <capabilities/>
  <proxies>
    <proxy proxybindingid="5001" primary="True" name="TP-Link Light">light_v2</proxy>
  </proxies>
  <connections>
    <connection>
      <id>300</id>
      <facing>6</facing>
      <connectionname>On Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>301</id>
      <facing>6</facing>
      <connectionname>Toggle Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>302</id>
      <facing>6</facing>
      <connectionname>Off Button Link</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>BUTTON_LINK</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Light</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>LIGHT_V2</classname>
        </class>
      </classes>
    </connection>
    <connection>
      <id>1</id>
      <facing>6</facing>
      <connectionname>TP-Link Outlet</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>TPLINK_LIGHT</classname>
        </class>
      </classes>
    </connection>
  </connections>
</devicedata>
