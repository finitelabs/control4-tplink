  <events/>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <!-- #endif -->
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #ifndef DRIVERCENTRAL -->
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <!-- #endif -->
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
      <property>
        <name>TP-Link Settings</name>
        <type>LABEL</type>
        <default>TP-Link Settings</default>
      </property>
      <property>
        <name>IP Address</name>
        <type>STRING</type>
        <default/>
        <description>IP address of the light, or blank when bound to a TP-Link Outlet.</description>
      </property>
      <property>
        <name>Protocol</name>
        <type>LIST</type>
        <items>
          <item>Auto</item>
          <item>KLAP</item>
          <item>Legacy</item>
        </items>
        <default>Auto</default>
        <description>Local protocol the light speaks, detected when set to Auto.</description>
      </property>
      <property>
        <name>TP-Link Username</name>
        <type>STRING</type>
        <default/>
        <description>Case-sensitive email of the TP-Link (Kasa/Tapo) account the light is bound to.</description>
      </property>
      <property>
        <name>TP-Link Password</name>
        <type>STRING</type>
        <password>true</password>
        <default/>
        <description>Password of the TP-Link (Kasa/Tapo) account the light is bound to.</description>
      </property>
      <property>
        <name>Poll Rate (Seconds)</name>
        <type>RANGED_INTEGER</type>
        <minimum>2</minimum>
        <maximum>300</maximum>
        <default>5</default>
        <description>How often to poll the light state in direct mode.</description>
      </property>
      <property>
        <name>Fades</name>
        <type>LIST</type>
        <items>
          <item>Driver</item>
          <item>Light</item>
        </items>
        <default>Driver</default>
        <description>Who makes a fade on a Tapo light: the driver or the light itself.</description>
      </property>
    </properties>
    <commands/>
    <actions>
      <action>
        <name>Reconnect</name>
        <command>Reconnect</command>
      </action>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>UpdateDrivers</command>
      </action>
      <!-- #endif -->
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
  </config>
  <capabilities>
    <!--
      Dimming is declared here and turned off at runtime, with
      DYNAMIC_CAPABILITIES_CHANGED, for a light that only switches: one bound
      to a TP-Link Outlet output. A dimmer turned on at runtime makes the proxy
      announce its default rate before Composer has the light's color
      capabilities. Color and color temperature are turned on at runtime. A
      consumer that reads this list and not the proxy's setup, as a HomeKit
      bridge may, sees a dimmer on an outlet-backed light.
    -->
    <dimmer>True</dimmer>
    <set_level>True</set_level>
    <supports_target>True</supports_target>
    <supports_brightness_stop>True</supports_brightness_stop>
    <!--
      on_off, ramp_level, and supports_default_on are documented as
      "deprecated in 3.3.2" but Composer's test panel still gates UI
      elements on them: on_off enables the On/Off level buttons;
      ramp_level enables the Ramp button; supports_default_on enables
      the Default On preset editor including its Inactive Color picker.
      ramp_level is turned off at runtime with dimming.
    -->
    <on_off>True</on_off>
    <ramp_level>True</ramp_level>
    <supports_default_on>True</supports_default_on>
    <has_fixed_ramp_rate>False</has_fixed_ramp_rate>
    <fixed_ramp_rate>0</fixed_ramp_rate>
    <hide_proxy_properties>False</hide_proxy_properties>
    <hide_proxy_events>False</hide_proxy_events>
    <click_rates>True</click_rates>
    <hold_rates>True</hold_rates>
    <cold_start>False</cold_start>
    <has_leds>False</has_leds>
    <has_button_events>True</has_button_events>
    <supports_broadcast_scenes>False</supports_broadcast_scenes>
    <supports_multichannel_scenes>False</supports_multichannel_scenes>
    <reduced_als_support>False</reduced_als_support>
    <advanced_scene_support>True</advanced_scene_support>
    <load_group_support>False</load_group_support>
    <brightness_on_mode_preset>True</brightness_on_mode_preset>
    <brightness_on_mode_previous>True</brightness_on_mode_previous>
    <color_on_mode_fade>True</color_on_mode_fade>
    <color_on_mode_preset>True</color_on_mode_preset>
    <color_on_mode_previous>True</color_on_mode_previous>
    <multi_click>False</multi_click>
    <has_extras>False</has_extras>
    <disable_flash>False</disable_flash>
    <brightness_rate_min>0</brightness_rate_min>
    <brightness_rate_max>65535</brightness_rate_max>
    <click_rate_min>0</click_rate_min>
    <click_rate_max>65535</click_rate_max>
    <hold_rate_min>1000</hold_rate_min>
    <hold_rate_max>86400000</hold_rate_max>
    <supports_color>False</supports_color>
    <supports_color_correlated_temperature>False</supports_color_correlated_temperature>
    <supports_color_stop>False</supports_color_stop>
    <color_correlated_temperature_min>2000</color_correlated_temperature_min>
    <color_correlated_temperature_max>6500</color_correlated_temperature_max>
    <color_rate_behavior>1</color_rate_behavior>
    <color_rate_min>0</color_rate_min>
    <color_rate_max>65535</color_rate_max>
  </capabilities>
